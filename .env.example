# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env and fill in. .env is gitignored — never commit a real key.
# This file documents the SHAPE only. No machine-specific path belongs in it.
# ─────────────────────────────────────────────────────────────────────────────

# ── Image generation ─────────────────────────────────────────────────────────
# Real imagery is a core requirement of a direction, not decoration — see the
# "Assets" section of README.md. Default provider is `codex`, which reuses your
# `codex login` session against an existing ChatGPT Plus subscription and needs
# no API key here.
IMAGE_GEN_PROVIDER=codex
# IMAGE_GEN_PROVIDER=local     # a self-hosted generation server (no per-image cost)
# IMAGE_GEN_PROVIDER=openai    # the OpenAI Images API (paid per image)

# --- provider: local ---
# The base URL of your own generation server. story-panel-studio
# (https://github.com/Rumeasiyan/story-panel-studio) is one such server; anything
# exposing the same POST /api/generate + GET /api/jobs/{id} contract works.
# Such servers typically have NO AUTHENTICATION — keep this on loopback unless you
# have put auth in front of it.
IMAGE_GEN_BASE_URL=
IMAGE_GEN_PIPELINE=sdxl-text-to-image
IMAGE_GEN_STEPS=25
# IMAGE_GEN_SEED=              # omit for a random seed; the server returns the one it used
# IMAGE_GEN_TIMEOUT_MS=600000  # generation queues behind a single GPU

# --- provider: openai ---
OPENAI_API_KEY=
# IMAGE_GEN_MODEL=gpt-image-1  # also passed through to the `local` provider

# ── Video generation ─────────────────────────────────────────────────────────
# OFF by default (manual mode — composes a prompt, calls no API, costs nothing).
# Set VIDEO_GEN_PROVIDER to turn on a paid API for a specific project.
VIDEO_GEN_PROVIDER=manual
# VIDEO_GEN_PROVIDER=replicate
# VIDEO_GEN_PROVIDER=openrouter
# VIDEO_GEN_PROVIDER=atlascloud

REPLICATE_API_TOKEN=
OPENROUTER_API_KEY=
ATLASCLOUD_API_KEY=
